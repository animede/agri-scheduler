# --- Python / backend ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
backend/.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Node / frontend ---
node_modules/
dist/
frontend/dist/
.vite/

# --- Environment ---
.env
.env.local
*.env

# --- Data (keep directories, ignore contents) ---
data/images/*
!data/images/.gitkeep
data/db/*.db
data/db/*.sqlite3
!data/db/.gitkeep
*.db
*.sqlite3

# --- Backups (scripts/backup.sh output; local-only, never committed) ---
backups/

# --- Editor / OS ---
.DS_Store
.vscode/
.idea/
*.log
.claude/
