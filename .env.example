# --- AI画像解析（品種登録画面。任意設定）---------------------------------
# 種苗パッケージ画像から栽培暦を自動抽出するAI画像解析機能を使う場合のみ、
# 以下のうちどちらか一方を設定する。両方未設定でもAI画像解析以外の全機能は
# 通常どおり使用できる。両方設定されている場合はANTHROPIC_API_KEYが優先される。

# Anthropic Claude API key（クラウドのVision APIを使う場合）
ANTHROPIC_API_KEY=

# OpenAI互換のローカル/リモートサーバー（llama.cpp server等、マルチモーダル
# 対応モデルを起動している場合。ANTHROPIC_API_KEYが無くてもこちらだけで動作する）
# 例: llama.cpp serverを http://127.0.0.1:64650 で起動している場合
AI_VISION_BASE_URL=http://127.0.0.1:64650/v1
# AI_VISION_BASE_URL使用時のモデル名。未設定の場合は `{AI_VISION_BASE_URL}/models`
# から先頭のモデルIDを自動取得する（取得できない場合はエラーになるため、
# 可能であれば明示的に設定することを推奨）
AI_VISION_MODEL=unsloth/gemma-4-31B-it-GGUF:Q4_K_XL

# SQLite接続先（backend/app/db.py のデフォルト値と同じ内容の例）
DATABASE_URL=sqlite:///../data/db/agri.db
